{
  "name": "ember",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "postinstall": "pnpm build:libs",
    "build": "pnpm -r build",
    "build:libs": "pnpm --filter './packages/**' build",
    "typecheck": "pnpm build:libs && pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.31.1",
    "@typescript-eslint/parser": "8.31.1",
    "eslint": "9.25.1",
    "typescript": "5.8.3",
    "vitest": "3.1.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"],
    "overrides": {
      "rollup": "4.40.0"
    }
  }
}
