# Mock demo (default): leave both unset.

# Vite dev proxy target when the server is not on 3000 (see apps/web/vite.config.ts):
# EMBER_SERVER_PORT=4000

# Live server via Vite proxy (run `startHttpApp` on port 3000):
# VITE_INCIDENT_REST_BASE_URL=

# Or point REST at a host explicitly:
# VITE_INCIDENT_REST_BASE_URL=http://127.0.0.1:3000

# Pre-configured WebSocket URL (skips POST /incidents create):
# Keep the token separate; the client authenticates through a WebSocket protocol offer.
# VITE_INCIDENT_WS_URL=ws://127.0.0.1:3000/incidents/<id>/events
# VITE_INCIDENT_ID=<id>
# VITE_INCIDENT_TOKEN=<token>

# Grok Voice (requires server XAI_API_KEY and live REST/WS):
# VITE_GROK_VOICE=1
# Server: export XAI_API_KEY=...  (optional export XAI_INTENT=1 for Grok command parsing)
