# Mock demo (default): leave both unset.

# Live server via Vite proxy (run `startHttpApp` on port 3000):
# VITE_INCIDENT_REST_BASE_URL=

# Or point REST at a host explicitly:
# VITE_INCIDENT_REST_BASE_URL=http://127.0.0.1:3000

# Pre-configured WebSocket URL (skips POST /incidents create):
# VITE_INCIDENT_WS_URL=ws://127.0.0.1:3000/incidents/<id>/events?token=<token>
# VITE_INCIDENT_ID=<id>
# VITE_INCIDENT_TOKEN=<token>
